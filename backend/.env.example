APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_URL=postgres://reanit:reanit@localhost:5432/reanit_lms
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
RUST_LOG=reanit_api=debug,tower_http=info
FRONTEND_URL=http://localhost:3000
# At least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=ReanIT <no-reply@reanit.local>
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reanit-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/reanit-media
S3_PATH_STYLE=true
# Run the video transcoding worker in the API process (needs ffmpeg on PATH)
WORKER_ENABLED=true
# WORKER_SCRATCH_DIR=/tmp/reanit-worker
